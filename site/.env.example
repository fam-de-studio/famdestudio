# Inquiry form email delivery (built-in /api/inquire route).
# Create a key at https://resend.com and set it on the host (Vercel: Project > Settings > Environment Variables).
# Without it the form opens the visitor's mail app instead.
RESEND_API_KEY=
# Optional verified sender, e.g. "FAM De Studio <hello@yourdomain.com>". Defaults to onboarding@resend.dev.
RESEND_FROM=

# Optional: post the form somewhere else instead (Formspree, Web3Forms, Basin, ...).
NEXT_PUBLIC_FORM_ENDPOINT=

# ---------- Press Docket (private quoting tool at /admin/docket) ----------
# Google sign-in (Auth.js). Create an OAuth client at console.cloud.google.com
# (APIs & Services > Credentials > OAuth client ID > Web application) with
# redirect URI  https://YOUR-DOMAIN/api/auth/callback/google
# (and http://localhost:3001/api/auth/callback/google for local use).
AUTH_SECRET=            # any long random string:  openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Who may sign in (comma-separated Google accounts)
ADMIN_EMAILS=famdestudio@gmail.com

# Storage: the existing Google Sheet. Create a service account in the same
# Cloud project (IAM & Admin > Service Accounts > Keys > JSON), enable the
# Google Sheets API, then share the spreadsheet with the service-account
# email as Editor. DOCKET_SHEET_ID is the long id in the sheet's URL.
DOCKET_SHEET_ID=
DOCKET_SA_EMAIL=
DOCKET_SA_KEY=          # the "private_key" from the JSON, quotes and 
 included

# Local development only: skip Google sign-in and store in .data/docket.json
# ADMIN_DEV_BYPASS=1
