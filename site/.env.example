# Inquiry form email delivery (built-in /api/inquire route).
# Create a key at https://resend.com and set it on the host (Vercel: Project > Settings > Environment Variables).
# Without it the form opens the visitor's mail app instead.
RESEND_API_KEY=
# Optional verified sender, e.g. "FAM De Studio <hello@yourdomain.com>". Defaults to onboarding@resend.dev.
RESEND_FROM=

# Optional: post the form somewhere else instead (Formspree, Web3Forms, Basin, ...).
NEXT_PUBLIC_FORM_ENDPOINT=
